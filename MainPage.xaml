<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyMauiApp.MainPage"
             Title="Уровень / Отвес">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="Center">

            <Label x:Name="StatusLabel"
                   Text="Нажмите «Старт», положите телефон на поверхность"
                   FontSize="18"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <Label x:Name="AngleLabel"
                   Text="0.0°"
                   FontSize="72"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="Gray" />

            <Label x:Name="RawLabel"
                   Text="X: 0.00   Y: 0.00   Z: 0.00"
                   FontSize="14"
                   HorizontalOptions="Center"
                   TextColor="Gray" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,10,0,0">
                <Border Grid.Column="0" Stroke="LightGray" StrokeThickness="1" Padding="10">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Наклон X" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />
                        <Label x:Name="AngleXLabel" Text="0.0°" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Stroke="LightGray" StrokeThickness="1" Padding="10">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Наклон Y" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />
                        <Label x:Name="AngleYLabel" Text="0.0°" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Button x:Name="ToggleButton"
                    Text="Старт"
                    Clicked="OnToggleClicked"
                    HorizontalOptions="Center"
                    WidthRequest="200" />

            <Label x:Name="HintLabel"
                   Text="Совет: положите телефон экраном вверх на проверяемую поверхность."
                   FontSize="12"
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>